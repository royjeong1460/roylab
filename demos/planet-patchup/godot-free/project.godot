config_version=5

[application]
config/name="Planet Patchup Godot Free Web"
config/version="0.5.41"
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="PlanetPatchupGodotFreeWeb"
run/main_scene="res://app/app.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0980392, 0.168627, 0.196078, 1)

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0353,0.0745,0.1333,1)

[physics]
common/physics_ticks_per_second=60
2d/default_gravity=280.0
2d/solver/solver_iterations=12

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[debug]
gdscript/warnings/untyped_declaration=0

[diagnostics]
performance_overlay=false
