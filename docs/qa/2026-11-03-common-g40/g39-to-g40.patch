+  cell_owners[at] = id;
+  int64_t start = ((y % CHUNK_CELLS) * CELL_PIXELS * CHUNK_PIXELS +
+                   (x % CHUNK_CELLS) * CELL_PIXELS) * 4;
+  for (int row = 0; row < CELL_PIXELS; ++row)
+    std::memcpy(chunk.rgba.data() + start + row * CHUNK_PIXELS * 4,
